<?php

require __DIR__ . '/../bootstrap.php';

use Dr2g\ErpLibs\CLI\Commands\AppCreateCommand;
use Dr2g\ErpLibs\CLI\Commands\AppServeCommand;
use Dr2g\ErpLibs\CLI\Commands\MakeControllerCommand;
use Dr2g\ErpLibs\CLI\Commands\MakeMiddlewareCommand;
use Dr2g\ErpLibs\CLI\Commands\MakeMigrationCommand;
use Dr2g\ErpLibs\CLI\Commands\MakeModelCommand;
use Dr2g\ErpLibs\CLI\Commands\MakeRequestCommand;
use Dr2g\ErpLibs\CLI\Commands\MakeRouteCommand;
use Dr2g\ErpLibs\CLI\Commands\MakeTestCommand;
use Dr2g\ErpLibs\CLI\Commands\MakeViewCommand;
use Dr2g\ErpLibs\CLI\Commands\MigrateCommand;
use Dr2g\ErpLibs\CLI\Commands\NewAppCommand;
use Dr2g\ErpLibs\CLI\Commands\RollbackCommand;
use Dr2g\ErpLibs\CLI\Console;

$console = new Console();
$console->addCommand(new AppCreateCommand());
$console->addCommand(new AppServeCommand());
$console->addCommand(new NewAppCommand());
$console->addCommand(new MakeControllerCommand());
$console->addCommand(new MakeModelCommand());
$console->addCommand(new MakeViewCommand());
$console->addCommand(new MakeRouteCommand());
$console->addCommand(new MakeMiddlewareCommand());
$console->addCommand(new MakeRequestCommand());
$console->addCommand(new MakeTestCommand());
$console->addCommand(new MakeMigrationCommand());
$console->addCommand(new MigrateCommand());
$console->addCommand(new RollbackCommand());

$console->run($_SERVER['argv']);
