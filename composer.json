{
    "name": "dr2gsistemas/erplibs",
    "description": "Librería PHP 8.4+ para ERP: ORM por atributos, migraciones, eventos, validación, serialización, caché, logging, auditoría y servidor API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "orm",
        "erp",
        "migrations",
        "query-builder",
        "api",
        "rest",
        "routing",
        "php84"
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3",
        "php-cs-fixer/shim": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Dr2g\\ErpLibs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dr2g\\ErpLibs\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/erplibs"
    ],
    "support": {
        "issues": "https://github.com/dr2gsistemas/erplibs/issues",
        "source": "https://github.com/dr2gsistemas/erplibs"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:all": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "audit:release": "php scripts/release-audit.php",
        "check": [
            "@test",
            "@analyse",
            "@lint"
        ],
        "release:check": [
            "@check",
            "@audit:release"
        ]
    },
    "authors": [
        {
            "name": "dr2gsistemas"
        }
    ]
}
